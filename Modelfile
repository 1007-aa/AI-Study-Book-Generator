# Ollama Modelfile for IAT Book Generator (Final)
# Tuned for: NVIDIA MX350 (2 GB VRAM) + i7-1165G7 + 7.5 GB RAM
# Run: ollama create iat-writer -f Modelfile

FROM llama3.2

# GPU: Offload layers to MX350 (prevents CUDA OOM on 2 GB VRAM)
PARAMETER num_gpu 10

# Context window: enough for full prompt + TikZ rules
PARAMETER num_ctx 4096

# CPU threads: leaves 2 for OS + ChromaDB
PARAMETER num_thread 4

# Temperature: low = consistent, textbook-style LaTeX output
PARAMETER temperature 0.2

SYSTEM """You are a senior science author writing a premium IISER Aptitude Test (IAT) preparation book. You write exclusively in LaTeX format. Your style is clear, conceptual, and aimed at deep understanding — not rote learning. You always produce original explanations and never copy verbatim from source material. When given reference material, you synthesize it into fresh, unique content."""
